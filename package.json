{
  "name": "play",
  "version": "1.0.0",
  "private": true,
  "description": "Play — one repository for the creator studio, the learner marketplace, a third-party demo app, and the AWS backend they share.",
  "workspaces": [
    "apps/*",
    "infra",
    "packages/*",
    "services/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev:studio",
    "dev:studio": "npm run dev --workspace play-studio",
    "dev:marketplace": "npm run dev --workspace play-marketplace",
    "dev:demo": "npm run dev --workspace play-demo",
    "build": "npm run build --workspace play-studio && npm run build --workspace play-marketplace && npm run build --workspace play-demo",
    "build:studio": "npm run build --workspace play-studio",
    "build:marketplace": "npm run build --workspace play-marketplace",
    "build:demo": "npm run build --workspace play-demo",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "get-env": "npm run get-env --workspace play-studio && npm run get-env --workspace play-marketplace && npm run get-env --workspace play-demo",
    "synth": "npm run synth --workspace play-infra",
    "diff": "npm run diff --workspace play-infra",
    "deploy": "npm run deploy --workspace play-infra",
    "deploy:dev": "npm run deploy:dev --workspace play-infra",
    "deploy:api": "npm run deploy:api --workspace play-infra",
    "deploy:data": "npm run deploy:data --workspace play-infra",
    "deploy:media": "npm run deploy:media --workspace play-infra",
    "deploy:auth": "npm run deploy:auth --workspace play-infra",
    "bootstrap": "npm run bootstrap --workspace play-infra",
    "bundle": "npm run bundle --workspace play-infra"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
