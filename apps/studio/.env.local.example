# Copy this file to .env.local and fill in values from `serverless deploy` outputs.
NEXT_PUBLIC_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/dev
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Google sign-in (optional) -------------------------------------------------
# Both values are written by `npm run get-env` when the backend was deployed with
# Google OAuth credentials (see play-backend/scripts/set-google-oauth.sh).
# Leave them unset to run with email/password sign-in only.

# Cognito Hosted UI domain (stack output `CognitoDomain`), no scheme.
NEXT_PUBLIC_COGNITO_DOMAIN=play-dev-123456789012.auth.us-east-1.amazoncognito.com

# "true" enables the "Sign In with Google" button (stack output `GoogleAuthEnabled`).
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true

# Where Cognito sends the user after sign-in/sign-out. Each URL must also be
# registered on the backend (custom.auth.callbackUrls / logoutUrls, or the
# /play/auth/callback-urls and /play/auth/logout-urls SSM parameters).
# Comma-separate several values (e.g. localhost + a deployed domain); Amplify
# picks the one matching the current origin.
# Defaults: http://localhost:3000/auth/callback and http://localhost:3000
# NEXT_PUBLIC_COGNITO_REDIRECT_SIGN_IN=http://localhost:3000/auth/callback
# NEXT_PUBLIC_COGNITO_REDIRECT_SIGN_OUT=http://localhost:3000

# --- Marketplace (optional) ----------------------------------------------------
# Where Play Marketplace is served. Publishing a course lists it in that
# marketplace's catalog, and this is the link the course overview offers back to
# it. Unset means this deployment has no marketplace, and the overview says so
# instead of linking nowhere.
NEXT_PUBLIC_MARKETPLACE_URL=http://localhost:3001
