# Copy this file to .env.local and fill in values from `serverless deploy` outputs,
# or run `npm run get-env` from this directory to fetch them from the stack.
#
# The marketplace is a second app against the same backend: the same user pool,
# the same API and the same videos. Somebody who registered in the marketplace
# signs in here with the account they use in the studio.
NEXT_PUBLIC_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/dev
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Google sign-in (optional) -------------------------------------------------
# Both values are written by `npm run get-env` when the backend was deployed with
# Google OAuth credentials (see services/api/scripts/set-google-oauth.sh).
# Leave them unset to run with email/password sign-in only.

# Cognito Hosted UI domain (stack output `CognitoDomain`), no scheme.
NEXT_PUBLIC_COGNITO_DOMAIN=play-dev-123456789012.auth.us-east-1.amazoncognito.com

# "true" enables the "Sign In with Google" button (stack output `GoogleAuthEnabled`).
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true

# --- Redirect URLs -------------------------------------------------------------
# Nothing to set in development. Both apps derive these from the origin they are
# running on (localhost:3001 here, localhost:3000 for the studio), and the backend
# registers both. Set them only to override that — for a deployed domain, say —
# and remember every value must also be registered on the backend
# (custom.auth.callbackUrls / logoutUrls, or the /play/auth/callback-urls and
# /play/auth/logout-urls SSM parameters).
# NEXT_PUBLIC_COGNITO_REDIRECT_SIGN_IN=http://localhost:3001/auth/callback
# NEXT_PUBLIC_COGNITO_REDIRECT_SIGN_OUT=http://localhost:3001
