# Where the Play API lives. The same value the studio and the marketplace use,
# and what `npm run get-env` writes — this file only adds the two below it.
NEXT_PUBLIC_API_URL=https://<your-api-id>.execute-api.<region>.amazonaws.com/dev

# Where the consent screen is served from. The studio, not the API: people sign
# in on Play's own page, and this app never sees a password.
NEXT_PUBLIC_PLAY_STUDIO_URL=http://localhost:3000

# Optional: where Play sends the browser back to. Defaults to
# {the origin you browse}/auth/play/callback, which is right for localhost:4000 —
# set one of these only when it is not, and remember it must match a URI
# registered on the app exactly.
# NEXT_PUBLIC_PLAY_REDIRECT_PATH=/auth/play/callback
# NEXT_PUBLIC_PLAY_REDIRECT_URI=http://localhost:4000/auth/play/callback

# The client id this app was registered as, copied out of the studio once.
#
# Minted by registering an app at {studio}/oauth/apps — with the redirect URI
# http://localhost:4000/auth/play/callback, matched exactly — and no client secret,
# because this app registers as a public client. See README.md.
NEXT_PUBLIC_PLAY_CLIENT_ID=

# The optional client secret this app was registered with, copied out of the studio once.
NEXT_PUBLIC_PLAY_CLIENT_SECRET=
