# CloudFront signed-URL key pair. Generate with scripts/generate-cloudfront-keypair.sh
# Public key: base64 of the DER-encoded public key (single line) -> CloudFront PublicKey.EncodedKey
CLOUDFRONT_PUBLIC_KEY=

# Private key: base64 of the PKCS#8 PEM private key (single line) -> used by Lambdas to sign URLs
CLOUDFRONT_PRIVATE_KEY=

# Region override (optional, defaults to us-east-1)
# AWS_REGION=us-east-1
