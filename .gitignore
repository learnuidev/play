# dependencies
node_modules/

# next.js
.next/
out/

# builds
build/
dist/
.tsbuildinfo
*.tsbuildinfo

# serverless
.serverless/
.build/

# misc
.DS_Store

# debug
*.log
npm-debug.log*

# env / secrets — the .example files are tracked, the real ones are not
.env
.env.local
.env.*.local
!.env.example
!.env.local.example

# A Vercel CLI session the console had to keep inside the repository, because
# its process could not write the CLI's own store (`apps/play/.vercel-cli`).
# A credential, exactly like the `.env.local` above it.
apps/play/.vercel-cli/

# pem
*.pem

# `book/` is a repository of its own, with its own history and its own remote —
# it is not part of this monorepo. Tracking it here would either embed it as a
# gitlink (a pointer to a commit no clone of this repo can fetch) or silently
# absorb its history. It stays a sibling on disk.
book/
