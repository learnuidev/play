# api-config.env — the one place this repository names the AWS profile its
# scripts reach the Play backend with.
#
# Plain `KEY=value` on purpose: the scripts that read it are written in two
# languages, and neither of them should need a tool to read a name.
#
#   bash   services/api/scripts/*.sh    infra/scripts/*.sh    . scripts/api-config.env
#   node   scripts/get-env.mjs                                 parsed line by line
#          infra/scripts/*.mjs
#          services/api/scripts/*.mjs
#
# The value here is a fallback, not the law: an AWS_PROFILE already in the
# environment wins over it, so a machine that deploys under a different profile
# needs no edit —
#
#   AWS_PROFILE=personal npm run get-env
#
# Keep it plain: no `export`, no quotes, no expansion. The Node readers are a
# short parser, not a shell.
#
# `cdk` is the one tool that cannot read this file — it takes the profile from
# AWS_PROFILE, and there is no `--profile` on `cdk deploy`. A shell that deploys
# takes the value from here, once:
#
#   export AWS_PROFILE="$(. scripts/api-config.env && printf %s "$API_AWS_PROFILE")"
#   npm run deploy

API_AWS_PROFILE=yoserverless
